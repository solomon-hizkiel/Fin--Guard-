{
  "manifest_version": 3,
  "name": "Fin-Guardian Scam Detector",
  "version": "1.0.0",
  "description": "Flags financial-crime language and Ethereum wallets on the current page.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:5001/*"],
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_title": "Fin-Guardian Scam Detector",
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
